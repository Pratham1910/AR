# Copy to .env and adjust for your environment.

DATABASE_URL=postgresql+psycopg2://tvasta:tvasta@localhost:5432/tvasta

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=tvasta
MINIO_SECRET_KEY=tvasta12345
MINIO_SECURE=false
MINIO_EVIDENCE_BUCKET=evidence

# Path to YOLO weights. Leave unset to use the mock detector (no trained model yet).
MODEL_PATH=
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.80
TRACKING_ENABLED=false
POSE_ENABLED=false

# Pose / registration (Phase 5). Leave CAMERA_CALIBRATION_PATH unset to use an
# approximate default calibration — fine for proving the pipeline, not for a
# measurement claim (Project.md #25). Generate a marker with
# `python -m app.workers.generate_marker`, print it, measure its printed side
# length in meters, and set ARUCO_MARKER_LENGTH_M to match.
CAMERA_CALIBRATION_PATH=
ARUCO_DICTIONARY=DICT_4X4_50
ARUCO_MARKER_LENGTH_M=0.10

# Marker -> product scanning (Marker Scan tab). ARUCO_DICTIONARY above is the
# dictionary; any cv2.aruco DICT_* name works. Which product each marker id
# means lives in the marker_bindings table, edited from that tab.
MARKER_FAMILY=aruco
MARKER_HOLD_MS=1500

# Automatic product scan: the marker names the product and YOLO must see that
# product at the marker before the scan confirms. Unset = the stock COCO model
# (SEGMENTATION_MODEL_NAME), which only knows everyday objects such as
# "bottle"; set this to custom-trained YOLO weights to verify your own
# equipment. A product's expected class is its 3D model's detection class.
PRODUCT_MODEL_PATH=
SCAN_MIN_PRODUCT_CONFIDENCE=0.5
# How far (in marker widths) the product's box may be from the marker.
SCAN_ASSOCIATION_REACH=1.0
# Scan box and positioning guidance. All relative to the picture: shares of
# the frame or of the scan box, never centimeters. The full list of scan_*
# settings, with what each one measures, is in backend/app/core/config.py.
SCAN_AREA_WIDTH=0.6
SCAN_AREA_HEIGHT=0.8
SCAN_CENTER_TOLERANCE=0.15
SCAN_MIN_MARKER_SIZE=0.06
SCAN_MAX_MARKER_SIZE=0.5
SCAN_MAX_PRODUCT_FILL=1.0
SCAN_MIN_SQUARENESS=0.6
SCAN_MAX_ROLL_DEG=180
SCAN_MAX_SPEED=0.8
SCAN_HOLD_MS=800
SCAN_REARM_MS=1000

# Directory of served GLB/glTF files (Phase 4), relative to the backend's
# working directory.
MODELS_3D_DIR=../data/models

# Auth (Phase 8) — deliberately minimal (email-only login, no password/SSO).
# CHANGE JWT_SECRET_KEY for any real deployment; the default only exists so
# local dev works without extra setup.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
