# Copy to .env and adjust for your environment.
#
# This file is read in two places:
#   - `docker compose` reads the repo-root .env for the ${...} values in
#     docker-compose.yml and passes it to the backend container;
#   - a backend started by hand (`uvicorn` / `alembic` from backend/) reads
#     backend/.env instead.
# Never commit a real .env.

# --- docker compose only -----------------------------------------------------
# Credentials of the bundled PostgreSQL and MinIO containers. These are the
# development defaults; uncomment and change them for anything others can
# reach. Changing them after the volumes exist does NOT change the stored
# credentials — PostgreSQL and MinIO only apply them when first initialised.
# POSTGRES_USER=tvasta
# POSTGRES_PASSWORD=tvasta
# POSTGRES_DB=tvasta
# MINIO_ROOT_USER=tvasta
# MINIO_ROOT_PASSWORD=tvasta12345
# Address the browser uses to reach MinIO (evidence image links). Set to the
# server's LAN name/IP when the browser is on another machine.
# MINIO_PUBLIC_ENDPOINT=localhost:9000
# Owner of files the backend container writes into ./data (`id -u` / `id -g`).
# TVASTA_UID=1000
# TVASTA_GID=1000
# Run a pre-built image instead of building one (offline installs).
# TVASTA_BACKEND_IMAGE=tvasta-backend:local

# --- backend -----------------------------------------------------------------
# In docker compose the next four are overridden with the service hostnames
# (postgres:5432, minio:9000) and the credentials above.
DATABASE_URL=postgresql+psycopg2://tvasta:tvasta@localhost:5432/tvasta

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=tvasta
MINIO_SECRET_KEY=tvasta12345
MINIO_SECURE=false
MINIO_EVIDENCE_BUCKET=evidence

# Path to YOLO weights. Leave unset to use the mock detector (no trained model yet).
# In docker compose ./models is mounted at /models, e.g. /models/yolo/best.pt.
MODEL_PATH=
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.80
TRACKING_ENABLED=false
POSE_ENABLED=false

# Pose / registration (Phase 5). Leave CAMERA_CALIBRATION_PATH unset to use an
# approximate default calibration — fine for proving the pipeline, not for a
# measurement claim (Project.md #25). Generate a marker with
# `python -m app.workers.generate_marker`, print it, measure its printed side
# length in meters, and set ARUCO_MARKER_LENGTH_M to match.
CAMERA_CALIBRATION_PATH=
ARUCO_DICTIONARY=DICT_4X4_50
ARUCO_MARKER_LENGTH_M=0.10

# Directory of served GLB/glTF files (Phase 4), relative to the backend's
# working directory.
MODELS_3D_DIR=../data/models

# Auth (Phase 8) — deliberately minimal (email-only login, no password/SSO).
# CHANGE JWT_SECRET_KEY for any real deployment; the default only exists so
# local dev works without extra setup.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
